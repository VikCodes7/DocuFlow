<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>DocuFlow: open-source licenses (Rust)</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; }
    pre { white-space: pre-wrap; background: #f5f5f5; padding: 1rem; font-size: 0.8rem; }
  </style>
</head>
<body>
  <h1>Open-source licenses</h1>
  <p>DocuFlow uses the following Rust crates.</p>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
    {{/each}}
  </ul>
  {{#each licenses}}
  <h2 id="{{id}}">{{name}}</h2>
  <p>Used by:</p>
  <ul>
    {{#each used_by}}
    <li>{{crate.name}} {{crate.version}}</li>
    {{/each}}
  </ul>
  <pre>{{text}}</pre>
  {{/each}}
</body>
</html>
